                                      <TablixCell>
                                        <CellContents>
                                          <Textbox Name="Textbox7">
                                            <CanGrow>true</CanGrow>
                                            <KeepTogether>true</KeepTogether>
                                            <Paragraphs>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>I acknowledge receipt of an advance of USD </Value>
                                                    <Style>
                                                      <FontFamily>Segoe UI</FontFamily>
                                                      <FontSize>9pt</FontSize>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Label>Amount</Label>
                                                    <Value>=Fields!ImprestAmount_Payments.Value</Value>
                                                    <Style>
                                                      <FontFamily>Segoe UI</FontFamily>
                                                      <FontSize>9pt</FontSize>
                                                      <FontWeight>Bold</FontWeight>
                                                      <Format>#,0.00;#,0.00 -</Format>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value> which I undertake to account for in full on or before the </Value>
                                                    <Style>
                                                      <FontFamily>Segoe UI</FontFamily>
                                                      <FontSize>9pt</FontSize>
                                                      <Format>0.00;0.00 -</Format>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Label>Imprest Deadline</Label>
                                                    <Value>=Fields!ImprestDeadline_Payments.Value</Value>
                                                    <Style>
                                                      <FontFamily>Segoe UI</FontFamily>
                                                      <FontSize>9pt</FontSize>
                                                      <Format>0.00;0.00 -</Format>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value>.In the event of my failure to surrender the advance within 7 days following return from official duty,the Finance Officer, will recover the amount in full from my salary in additional to any other action that may be preferred against me.</Value>
                                                    <Style>
                                                      <FontFamily>Segoe UI</FontFamily>
                                                      <FontSize>9pt</FontSize>
                                                      <Format>0.00;0.00 -</Format>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                            </Paragraphs>
                                            <rd:DefaultName>Textbox7</rd:DefaultName>
                                            <Style>
                                              <Border>
                                                <Color>LightGrey</Color>
                                                <Style>Solid</Style>
                                              </Border>
                                              <PaddingLeft>2pt</PaddingLeft>
                                              <PaddingRight>2pt</PaddingRight>
                                              <PaddingTop>2pt</PaddingTop>
                                              <PaddingBottom>2pt</PaddingBottom>
                                            </Style>
                                          </Textbox>
                                          <ColSpan>3</ColSpan>
                                        </CellContents>
                                      </TablixCell>
